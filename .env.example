# ==============================================================================
# Second Chance Transplant Foundation — Production Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.production and provide your credentials.
# Replace placeholders with your production credentials from:
# https://supabase.com/dashboard/project/<your-project-id>/settings/api

# ------------------------------------------------------------------------------
# 1. Supabase Client-Side Configuration (Safe for client build)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ------------------------------------------------------------------------------
# 2. Supabase Server-Side Configuration (SSR / Nitro server)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_PROJECT_ID=your-project-ref

# ------------------------------------------------------------------------------
# 3. Server-Only Secret Key (NEVER expose to browser client)
# ------------------------------------------------------------------------------
# Optional: Only needed if running privileged server functions
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------------------------------------------------------------------
# 4. Canonical Custom Domain (e.g., your GoDaddy Domain)
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://secondchancetransplant.org

# ------------------------------------------------------------------------------
# 5. Lead Email Notifications (bavly.hamdyai@gmail.com)
# ------------------------------------------------------------------------------
NOTIFICATION_EMAIL=bavly.hamdyai@gmail.com
VITE_NOTIFICATION_EMAIL=bavly.hamdyai@gmail.com
# Obtain your free API key from https://resend.com (3,000 emails/month free)
# RESEND_API_KEY=re_your_api_key_here
# VITE_RESEND_API_KEY=re_your_api_key_here
# Optional custom sender once domain is verified on Resend:
# RESEND_FROM_EMAIL="Second Chance Leads <leads@secondchancetransplant.org>"


